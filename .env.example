# --- LaLiga Fantasy ---
# Opcionales: si no los pones, se usa tu primera liga y se detecta tu equipo.
FANTASY_LEAGUE_ID=
FANTASY_TEAM_ID=

# --- Telegram (alertas e informe diario) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ajustes ---
CLAUSE_WINDOW_HOURS=24     # avisar de cláusulas que se desbloquean en las próximas N horas
WATCH_INTERVAL_MIN=30      # cada cuánto revisa en modo watch
REPORT_HOUR=9              # hora del informe diario (hora de España)
MARKET_STUDY_HOUR=21       # hora del estudio de mercado diario (hora de España; el mercado se refresca a las 21:00)
MARKET_STUDY_MINUTE=5      # minuto del estudio de mercado (margen tras el refresco)
REQUEST_DELAY_S=0.4        # pausa entre peticiones a la API
