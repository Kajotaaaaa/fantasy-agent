# --- LaLiga Fantasy ---
# Opcionales: si no los pones, se usa tu primera liga y se detecta tu equipo.
FANTASY_LEAGUE_ID=
FANTASY_TEAM_ID=

# --- Telegram (alertas e informe diario) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ajustes ---
CLAUSE_WINDOW_HOURS=24     # avisar de cláusulas que se desbloquean en las próximas N horas
WATCH_INTERVAL_MIN=30      # cada cuánto revisa en modo watch
# Ni el estudio de mercado ni el informe diario tienen hora fija: ambos se detectan solos
# comparando el reloj con el próximo cierre real de la liga (expirationDate de los anuncios), así
# que se adaptan a cualquier ciclo (uno al día, dos, el que tenga tu liga) sin configurar nada. El
# informe diario se manda justo tras el ÚLTIMO cierre de cada día natural.
REQUEST_DELAY_S=0.4        # pausa entre peticiones a la API
# FANTASY_DATA_DIR=./data  # tokens, SQLite

# --- Panel web (Fase 1, 2026-09-27) ---
# Desplegado como servicio propio siempre encendido en Render (render.yaml) -- estas dos claves
# se ponen ahí como variables de entorno del servicio, NO en este .env local (salvo que también
# quieras correr `serve`/`watch` en tu propio ordenador para probar). Genera cada una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# DASHBOARD_TOKEN_SECRET debe coincidir con el secreto del mismo nombre en el Worker de Cloudflare.
# WEBAPP_SYNC_SECRET debe coincidir con el secreto del mismo nombre en GitHub Actions (protege
# /internal/sync-tokens, el empuje de la sesión ya refrescada tras cada tick -- ver CLAUDE.md).
DASHBOARD_TOKEN_SECRET=
WEBAPP_SYNC_SECRET=
WEB_PORT=8787              # solo para correr `serve`/`watch` en local; Render usa su propio PORT
