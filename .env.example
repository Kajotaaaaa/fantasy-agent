# --- LaLiga Fantasy ---
# Opcionales: si no los pones, se usa tu primera liga y se detecta tu equipo.
FANTASY_LEAGUE_ID=
FANTASY_TEAM_ID=

# --- Telegram (alertas e informe diario) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ajustes ---
CLAUSE_WINDOW_HOURS=24     # avisar de cláusulas que se desbloquean en las próximas N horas
WATCH_INTERVAL_MIN=30      # cada cuánto revisa en modo watch
REPORT_HOUR=9              # hora del informe diario (hora de España)
# El estudio de mercado ya no tiene hora fija: se detecta solo comparando el reloj con el
# próximo cierre real de la liga (expirationDate de los anuncios), así que se adapta a
# cualquier ciclo (uno al día, dos, el que tenga tu liga) sin configurar nada.
REQUEST_DELAY_S=0.4        # pausa entre peticiones a la API
# FANTASY_DATA_DIR=./data  # tokens, SQLite
